---
import { profile } from '../data/profile';
import { withBase } from '../utils/urls';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 border-b border-black bg-white">
  <nav class="page-shell relative flex min-h-14 items-stretch justify-between" aria-label="Navigasi utama">
    <a
      href={withBase('/')}
      class="display flex items-center border-r border-black px-4 text-lg"
      aria-label={`${profile.name} beranda`}
    >
      BARKAH
    </a>
    <details class="site-nav">
      <summary class="invert-hover flex min-h-14 items-center gap-2 px-4 text-xs font-bold uppercase md:hidden" aria-label="Buka menu navigasi">
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </summary>
      <div class="nav-links bg-white">
        {navItems.map((item) => {
          const itemHref = withBase(item.href);
          const isActive = item.href === '/' ? currentPath === itemHref : currentPath.startsWith(itemHref);
          return (
            <a
              href={itemHref}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'invert-hover flex min-h-14 items-center border-l border-black px-4 text-xs font-bold uppercase',
                isActive && 'bg-black text-white',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    </details>
    <div class="desktop-nav hidden">
      {navItems.map((item) => {
        const itemHref = withBase(item.href);
        const isActive = item.href === '/' ? currentPath === itemHref : currentPath.startsWith(itemHref);
        return (
          <a
            href={itemHref}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'invert-hover flex min-h-14 items-center border-l border-black px-4 text-xs font-bold uppercase',
              isActive && 'bg-black text-white',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>
