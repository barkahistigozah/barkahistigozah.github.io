---
import ContactLinks from '../components/ContactLinks.astro';
import { profile } from '../data/profile';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Contact"
  description="Kontak Barkah Istigozah untuk project website, automation, dan kolaborasi AI-assisted development."
>
  <section class="page-shell reveal py-14 md:py-20">
    <div class="max-w-3xl">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-4 text-4xl font-black leading-tight md:text-6xl">Ada project yang ingin dibuat?</h1>
      <p class="mt-5 text-lg leading-8 text-[color:var(--muted)]">
        Kirim detail singkat lewat email atau hubungi saya melalui GitHub dan LinkedIn.
      </p>
    </div>
    <form class="motion-card mt-10 grid max-w-3xl gap-4 rounded-[8px] border border-[color:var(--line)] bg-[color:var(--panel)] p-5" action={`mailto:${profile.email}`} method="post" enctype="text/plain">
      <label class="grid gap-2 text-sm font-bold">
        Nama
        <input class="rounded-[8px] border border-[color:var(--line)] bg-white px-4 py-3 text-base font-normal" name="name" type="text" placeholder="Nama Anda" required />
      </label>
      <label class="grid gap-2 text-sm font-bold">
        Email
        <input class="rounded-[8px] border border-[color:var(--line)] bg-white px-4 py-3 text-base font-normal" name="email" type="email" placeholder="email@domain.com" required />
      </label>
      <label class="grid gap-2 text-sm font-bold">
        Pesan
        <textarea class="min-h-36 rounded-[8px] border border-[color:var(--line)] bg-white px-4 py-3 text-base font-normal" name="message" placeholder="Ceritakan kebutuhan project Anda" required></textarea>
      </label>
      <button class="motion-button text-panel w-fit rounded-full bg-[color:var(--ink)] px-6 py-3 text-sm font-bold transition hover:bg-[color:var(--accent-strong)]" type="submit">
        Kirim via Email
      </button>
    </form>
  </section>
  <ContactLinks />
</SiteLayout>
