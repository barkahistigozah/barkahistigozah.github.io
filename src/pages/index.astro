---
import { getCollection } from 'astro:content';
import ArticleList from '../components/ArticleList.astro';
import ArchiveHero from '../components/ArchiveHero.astro';
import ContactLinks from '../components/ContactLinks.astro';
import ProjectFilter from '../components/ProjectFilter';
import SectionHeading from '../components/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { makeArchiveId } from '../utils/archive';
import { siteBase } from '../utils/urls';

const allProjects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = allProjects.filter((project) => project.data.featured).slice(0, 4);
const serializableProjects = projects.map((project, index) => ({
  id: project.id,
  archiveId: makeArchiveId(index),
  title: project.data.title,
  description: project.data.description,
  date: project.data.date.toISOString(),
  year: project.data.date.getFullYear(),
  role: project.data.role,
  tags: project.data.tags,
}));

const articles = (await getCollection('blog'))
  .filter((article) => article.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<SiteLayout
  title="Barkah Istigozah | AI Assisted Developer"
  description="Portfolio Barkah Istigozah, web developer yang fokus pada Vibe Engineering, AI-assisted workflow, web development, dan automation."
>
  <ArchiveHero projectCount={allProjects.length} noteCount={articles.length} />

  <section class="page-shell mt-8">
    <SectionHeading
      eyebrow="Selected Portfolio Projects"
      title="SELECTED / WORK"
      description="Project Portfolio yang sudah saya buat."
      href="/portfolio/"
      linkLabel="Semua project"
    />
    <ProjectFilter client:idle projects={serializableProjects} baseUrl={siteBase} />
  </section>

  <section class="page-shell mt-20">
    <SectionHeading
      eyebrow="Selected Blog Articles"
      title="FIELD / NOTES"
      description="Artikel untuk dokumentasi proses, eksperimen, dan cara kerja yang bisa dibaca."
      href="/blog/"
      linkLabel="Semua artikel"
    />
    <ArticleList articles={articles} />
  </section>

  <ContactLinks />
</SiteLayout>
