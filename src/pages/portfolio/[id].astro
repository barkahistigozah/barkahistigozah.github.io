---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { withBase } from '../../utils/urls';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ContentLayout
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  tags={project.data.tags}
  eyebrow={project.data.role}
  backHref="/portfolio/"
  backLabel="Kembali ke portfolio"
  image={project.data.thumbnail}
>
  <img src={withBase(project.data.thumbnail)} alt={`Thumbnail ${project.data.title}`} class="mb-8 aspect-video w-full border border-black object-cover" loading="eager" width="1280" height="720" />
  <Content />
  {(project.data.externalLink || project.data.repositoryLink) && (
    <div class="mt-10 flex flex-wrap gap-3">
      {project.data.externalLink && (
        <a href={project.data.externalLink} class="invert-hover inline-flex min-h-11 items-center border border-black px-4 py-3 text-xs font-bold uppercase">
          Live / Demo
        </a>
      )}
      {project.data.repositoryLink && (
        <a href={project.data.repositoryLink} class="invert-hover inline-flex min-h-11 items-center border border-black px-4 py-3 text-xs font-bold uppercase">
          Repository
        </a>
      )}
    </div>
  )}
</ContentLayout>
