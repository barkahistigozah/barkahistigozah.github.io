---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/urls';

interface Props {
  articles: CollectionEntry<'blog'>[];
  currentPage?: number;
  totalPages?: number;
}

const { articles, currentPage = 1, totalPages = 1 } = Astro.props;
const formatDate = (date: Date) => new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
const pageHref = (page: number) => page === 1 ? '/blog/' : `/blog/${page}/`;
---

<div class="border-b border-black">
  <div class="article-list-grid grid border-t border-black text-[10px] font-bold uppercase tracking-[.12em]" aria-hidden="true">
    <span class="p-3">Date</span><span class="border-l border-black p-3">Title</span><span class="border-l border-black p-3">Open</span>
  </div>
  {articles.map((article) => (
    <article class="article-list-grid invert-hover grid border-t border-black">
      <time class="p-3 text-xs" datetime={article.data.date.toISOString()}>
        {formatDate(article.data.date)}
      </time>
      <div class="min-w-0 border-l border-black p-3">
        <h3 class="font-[family-name:var(--font-display)] text-xl font-bold tracking-[-.03em]">
          <a href={withBase(`/blog/${article.id}/`)}>{article.data.title}</a>
        </h3>
        <p class="mt-2 max-w-3xl text-sm leading-6">{article.data.excerpt}</p>
      </div>
      <a class="flex min-h-11 items-center border-l border-black p-3 text-xs font-bold uppercase" href={withBase(`/blog/${article.id}/`)}>Read →</a>
    </article>
  ))}
  {totalPages > 1 && (
    <nav class="flex flex-wrap items-center justify-between gap-3 border-t border-black px-3 py-3 text-xs font-bold uppercase" aria-label="Blog pagination">
      {currentPage > 1 ? <a class="invert-hover inline-flex min-h-11 items-center border border-black px-3" href={withBase(pageHref(currentPage - 1))}>Previous</a> : <span />}
      <span>Page {currentPage} / {totalPages}</span>
      {currentPage < totalPages ? <a class="invert-hover inline-flex min-h-11 items-center border border-black px-3" href={withBase(pageHref(currentPage + 1))}>Next</a> : <span />}
    </nav>
  )}
</div>
