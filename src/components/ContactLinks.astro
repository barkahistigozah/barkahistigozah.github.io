---
import { profile } from '../data/profile';
---

<section id="contact" class="page-shell mt-20 border-y border-black">
  <div class="grid md:grid-cols-2">
    <h2 class="display p-4 text-[clamp(2.5rem,6vw,6rem)]">LET'S BUILD</h2>
    <div class="border-t border-black p-4 md:border-l md:border-t-0">
      <p class="max-w-2xl leading-7">Terbuka untuk project website, automation, landing page, dan eksperimen produk digital berbasis AI-assisted workflow.</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a class="invert-hover inline-flex min-h-11 items-center border border-black px-4 py-3 text-xs font-bold uppercase" href={`mailto:${profile.email}`}>Email</a>
        <a class="invert-hover inline-flex min-h-11 items-center border border-black px-4 py-3 text-xs font-bold uppercase" href={profile.github}>GitHub</a>
        <a class="invert-hover inline-flex min-h-11 items-center border border-black px-4 py-3 text-xs font-bold uppercase" href={profile.linkedin}>LinkedIn</a>
      </div>
    </div>
  </div>
</section>
