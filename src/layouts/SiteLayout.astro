---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { profile } from '../data/profile';
import { absoluteSiteUrl, withBase } from '../utils/urls';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  publishedTime?: Date;
  tags?: string[];
}

const { title, description, type = 'website', image = profile.image, publishedTime, tags = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title.includes('Barkah') ? title : `${title} | Barkah Istigozah`;
const absoluteImage = image.startsWith('http') ? image : absoluteSiteUrl(image, Astro.site);
const keywords = [
  'Barkah Istigozah',
  'portfolio developer',
  'junior full-stack web developer',
  'AI-assisted engineering',
  'Astro developer',
  'React developer',
  'Laravel developer',
  ...tags,
];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'Person',
  name: type === 'article' ? pageTitle : profile.name,
  headline: pageTitle,
  description,
  url: canonical.toString(),
  image: absoluteImage,
  ...(type === 'article' && publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
  ...(type !== 'article'
    ? {
        jobTitle: profile.role,
        email: profile.email,
        sameAs: [profile.github, profile.linkedin],
        knowsAbout: [...profile.skills, ...profile.languages, ...profile.tools],
      }
    : {
        author: {
          '@type': 'Person',
          name: profile.name,
          url: Astro.site?.toString(),
        },
      }),
};
---

<!doctype html>
<html id="top" lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={profile.name} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="theme-color" content="#0B2A4A" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate icon" type="image/x-icon" href={withBase('/images/icon.ico')} />
    <link rel="shortcut icon" href={withBase('/images/icon.ico')} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content="Barkah Istigozah Portfolio" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const resetPageScroll = () => {
        if (window.location.hash) return;
        const previousBehavior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = 'auto';
        window.scrollTo(0, 0);
        document.documentElement.style.scrollBehavior = previousBehavior;
      };
      window.history.scrollRestoration = 'manual';
      resetPageScroll();
      const resetAfterRestore = () => {
        resetPageScroll();
        window.setTimeout(resetPageScroll, 100);
      };
      window.addEventListener('load', resetAfterRestore, { once: true });
      window.addEventListener('pageshow', resetAfterRestore, { once: true });
      document.addEventListener('astro:page-load', resetPageScroll);
    </script>
  </body>
</html>
