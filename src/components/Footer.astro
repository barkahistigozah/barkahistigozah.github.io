---
import { profile } from '../data/profile';
---

<footer class="mt-20 bg-black text-white">
  <div class="page-shell border-b border-white px-4 py-8">
    <p class="display text-[clamp(3.5rem,15vw,13rem)]">AVAILABLE FOR WORK</p>
  </div>
  <div class="page-shell grid gap-8 px-4 py-8 text-xs uppercase md:grid-cols-3">
    <div>
      <p>Developer</p>
      <p class="mt-2">{profile.name}</p>
      <p>{profile.location}</p>
    </div>
    <div>
      <p>Contact</p>
      <a class="underline" href={`mailto:${profile.email}`}>Email</a><br />
      <a class="underline" href={profile.github}>GitHub</a><br />
      <a class="underline" href={profile.linkedin}>LinkedIn</a>
    </div>
    <div>
      <p>Colophon</p>
      <p class="mt-2 normal-case leading-6">You imagine, our code delivers</p>
    </div>
  </div>
  <a class="back-to-top" href="#top" aria-label="Kembali ke atas" title="Kembali ke atas">↑</a>
</footer>
