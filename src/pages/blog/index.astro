---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const articles = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SiteLayout
  title="Blog"
  description="Artikel teknis Barkah Istigozah tentang AI-assisted development, web workflow, Docker, WSL, dan engineering notes."
>
  <section class="page-shell py-10 md:py-16">
    <SectionHeading
      eyebrow="Blog"
      title="FIELD / NOTES"
      description="Artikel teknis dan dokumentasi project yang ditulis rapi untuk mendukung portfolio."
    />
    <ArticleList articles={articles} />
  </section>
</SiteLayout>
