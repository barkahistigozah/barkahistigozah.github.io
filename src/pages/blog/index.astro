---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPageCount, paginate } from '../../utils/pagination';

const PAGE_SIZE = 10;
const allArticles = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const articles = paginate(allArticles, 1, PAGE_SIZE);
const totalPages = getPageCount(allArticles.length, PAGE_SIZE);
---

<SiteLayout
  title="Blog"
  description="Artikel teknis Barkah Istigozah tentang AI-assisted development, web workflow, Docker, WSL, dan engineering notes."
>
  <section class="page-shell py-10 md:py-16">
    <SectionHeading
      eyebrow="Blog"
      title="FIELD NOTES"
    />
    <ArticleList articles={articles} currentPage={1} totalPages={totalPages} />
  </section>
</SiteLayout>
