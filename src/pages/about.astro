---
import ContactLinks from '../components/ContactLinks.astro';
import TagList from '../components/TagList.astro';
import { profile } from '../data/profile';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/urls';
---

<SiteLayout
  title="About"
  description="Profil singkat Barkah Istigozah, developer yang fokus pada AI-assisted development, web engineering, dan automation."
>
  <section class="page-shell grid gap-8 py-10 md:grid-cols-[minmax(260px,.7fr)_1.3fr] md:py-16">
    <div class="px-4">
      <p class="text-xs font-bold uppercase">About Dossier</p>
      <h1 class="display mt-4 text-[clamp(3rem,7vw,7rem)]">{profile.name}</h1>
      <img src={withBase(profile.image)} alt={`Portrait of ${profile.name}`} class="mt-6 aspect-[4/5] w-full border border-black object-cover" width="640" height="800" />
    </div>
    <div class="max-w-3xl border-t border-black px-4">
      <p>
        Saya adalah developer yang sedang fokus membangun portfolio di bidang web development, automation, dan AI-assisted workflow.
        Pendekatan saya sederhana: pahami masalahnya, buat struktur yang mudah dirawat, lalu iterasi cepat sampai hasilnya terasa berguna.
      </p>
      <section class="border-t border-black py-6"><h2 class="display text-3xl">Fokus Keahlian</h2>
      <p>
        Fokus utama saya adalah Vibe Engineering dan AI Assisted Development, terutama untuk membuat website, prototipe produk, dan sistem kecil yang bisa
        membantu pekerjaan sehari-hari.
      </p>
      <TagList tags={profile.skills} /></section>
      <section class="border-t border-black py-6"><h2 class="display text-3xl">Bahasa Framework</h2><TagList tags={profile.languages} /></section>
      <section class="border-y border-black py-6"><h2 class="display text-3xl">Tools</h2><TagList tags={profile.tools} /></section>
    </div>
  </section>
  <ContactLinks />
</SiteLayout>
