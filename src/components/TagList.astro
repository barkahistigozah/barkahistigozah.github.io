---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tag-list flex flex-wrap gap-2" aria-label="Tags">
  {tags.map((tag) => (
    <li class="motion-chip rounded-full border border-[color:var(--line)] bg-[color:var(--panel)] px-3 py-1 text-sm font-semibold text-[color:var(--muted)] hover:border-[color:var(--accent)] hover:text-[color:var(--ink)]">
      {tag}
    </li>
  ))}
</ul>
