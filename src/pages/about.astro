---
import ContactLinks from '../components/ContactLinks.astro';
import TagList from '../components/TagList.astro';
import { profile } from '../data/profile';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/urls';
---

<SiteLayout
  title="About"
  description="Profil Barkah Istigozah, junior full-stack web developer dengan 4+ tahun pengalaman freelance dan workflow AI-assisted engineering."
>
  <section class="page-shell grid gap-8 py-10 md:grid-cols-[minmax(260px,.7fr)_minmax(0,1.3fr)] md:py-16">
    <div class="min-w-0 px-4">
      <p class="text-xs font-bold uppercase">About Dossier</p>
      <h1 class="display mt-4 max-w-full text-[clamp(3rem,5vw,5rem)]">{profile.name}</h1>
      <img src={withBase(profile.image)} alt={`Portrait of ${profile.name}`} class="mt-6 aspect-[4/5] w-full border border-black object-cover" width="640" height="800" />
    </div>
    <div class="min-w-0 max-w-3xl border-t border-black px-4 pt-6 md:pt-12">
      <p class="max-w-prose text-base leading-7">
        Saya adalah Junior Full-Stack Web Developer dengan 4+ tahun pengalaman freelance membangun landing page, website bisnis,
        dan aplikasi web full-stack. Saya terbuka untuk peluang remote junior web developer, freelance, dan internship.
      </p>
      <section class="mt-8 space-y-4 border-t border-black py-6"><h2 class="display text-3xl">Fokus Keahlian</h2>
      <p class="max-w-prose leading-7">
        Saya menggunakan AI-assisted engineering untuk mempercepat debugging, refactoring, penulisan boilerplate, dokumentasi,
        dan eksplorasi solusi, lalu tetap meninjau logika serta kualitas implementasi akhir secara mandiri.
      </p>
      <TagList tags={profile.skills} /></section>
      <section class="space-y-4 border-t border-black py-6"><h2 class="display text-3xl">Bahasa Framework</h2><TagList tags={profile.languages} /></section>
      <section class="space-y-4 border-t border-black py-6"><h2 class="display text-3xl">Database</h2><TagList tags={profile.databases} /></section>
      <section class="space-y-4 border-y border-black py-6"><h2 class="display text-3xl">Tools</h2><TagList tags={profile.tools} /></section>
    </div>
  </section>
  <ContactLinks />
</SiteLayout>
