---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/urls';

interface Props {
  articles: CollectionEntry<'blog'>[];
}

const { articles } = Astro.props;
const formatDate = (date: Date) => new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
---

<div class="divide-y divide-[color:var(--line)] border-y border-[color:var(--line)]">
  {articles.map((article) => (
    <article class="article-row reveal grid gap-4 py-6 md:grid-cols-[160px_1fr_auto] md:items-start md:gap-6">
      <time class="text-sm font-bold text-[color:var(--muted)]" datetime={article.data.date.toISOString()}>
        {formatDate(article.data.date)}
      </time>
      <div>
        <h3 class="text-xl font-black leading-tight text-[color:var(--ink)] md:text-2xl">
          <a class="motion-link transition hover:text-[color:var(--accent-strong)]" href={withBase(`/blog/${article.id}/`)}>{article.data.title}</a>
        </h3>
        <p class="mt-3 max-w-3xl text-base leading-7 text-[color:var(--muted)]">{article.data.excerpt}</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Article tags">
          {article.data.tags.map((tag) => (
            <li class="text-sm font-bold text-[color:var(--accent-strong)]">#{tag}</li>
          ))}
        </ul>
      </div>
      <a
        href={withBase(`/blog/${article.id}/`)}
        class="motion-button inline-flex w-fit items-center justify-center rounded-full border border-[color:var(--line)] px-4 py-2 text-sm font-bold text-[color:var(--ink)] transition hover:border-[color:var(--ink)] hover:bg-[color:var(--panel)]"
      >
        Baca
      </a>
    </article>
  ))}
</div>
