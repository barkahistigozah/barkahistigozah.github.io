---
import { getCollection } from 'astro:content';
import ProjectFilter from '../../components/ProjectFilter';
import SectionHeading from '../../components/SectionHeading.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { makeArchiveId } from '../../utils/archive';
import { siteBase } from '../../utils/urls';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const serializableProjects = projects.map((project, index) => ({
  id: project.id,
  archiveId: makeArchiveId(index),
  title: project.data.title,
  description: project.data.description,
  thumbnail: project.data.thumbnail,
  date: project.data.date.toISOString(),
  year: project.data.date.getFullYear(),
  role: project.data.role,
  tags: project.data.tags,
}));
---

<SiteLayout
  title="Portfolio"
  description="Daftar project full-stack web development Barkah Istigozah, termasuk aplikasi React, FastAPI, SvelteKit, PHP, dan Astro."
>
  <section class="page-shell py-10 md:py-16">
    <SectionHeading
      eyebrow="Portfolio"
      title="WORK"
    />
    <ProjectFilter client:idle projects={serializableProjects} baseUrl={siteBase} />
  </section>
</SiteLayout>
